<?xml version="1.0" encoding="UTF-8"?>
<config>
	<imagevue>
		<settings>
			<sitetitle title="Site Title" type="string" description="Set the website title">Imagevue Gallery</sitetitle>
			<contentfolder title="Content Folder" type="string" description="Set the path for the main content and folders">content/</contentfolder>
			<adminfolder title="Admin Folder" type="string" description="Set the path for the administrative folder">iv-admin/</adminfolder>
			<startpath title="Start Folder" type="dir" description="Set the folder to be displayed on startup">start/</startpath>
			<htmlstartpath title="HTML Start Path" type="dir" description="Set the starting directory for the HTML gallery">/</htmlstartpath>
			<startmode title="Start Mode" type="enum" description="Set whether to start in thumbnails or image mode" options="thumbnails,image">thumbnails</startmode>
			<language type="language" description="Select the language (must exist in the languages folder)">english</language>
			<useswfaddress title="SWF Address" type="boolean" description="Enable flash link navigation">true</useswfaddress>
			<url_params title="URL Parameters" type="array" separator="," description="Set a group of parameters that can be used in the URL">globalpath, theme, contentfolder, startpath, startmode, language, maincontrols, stylesheet</url_params>
			<allowedext title="Allowed Extensions" type="array" separator="," description="Allowed file extensions for the gallery">mp3, jpg, png, gif, jpeg, swf, doc, docx, flv, mp4, m4v, html, pdf, txt</allowedext>
			<includefilesext title="Included Extensions" type="array" separator="," description="Include default extensions in file processing">jpg, gif, png, jpeg, flv, mp4, m4v, swf, docx, doc, html, txt, pdf</includefilesext>
			<videofilesext title="Video Extensions" type="array" separator="," description="Video file extensions to be processed">flv, mp4, m4v</videofilesext>
			<excludefilesprefix title="Exclude Prefix" type="array" separator="," description="Prefixes to be excluded from file processing">tn_, thumb_</excludefilesprefix>
			<dateformat title="Date Format" type="string" description="Set the date format">d M Y</dateformat>
			<theme type="Theme" description="Set the default theme">carbonizer</theme>
			<defaultPage title="Default Page" description="Default page: Flash / HTML" type="enum" options="gallery,html">gallery</defaultPage>
			<enableHTML title="Enable HTML" description="Enable the HTML gallery; if disabled, only Flash is available" type="boolean">true</enableHTML>
			<useLightview title="Lightview" description="Use Lightview to view photos in the HTML version" type="boolean">false</useLightview>
			<defaultSortFiles title="Sort Files" description="Default file sorting method - name, date, or size" type="enum" options="na,nd,ta,td,da,dd,sa,sd,rnd">na</defaultSortFiles>
			<defaultViewAs title="Default View" description="Default item list view - grid, list, or text" type="enum" options="grid,list,text">grid</defaultViewAs>
			<uploader title="Uploader">
				<type title="Type" description="File upload method" type="enum" options="swfupload,html">swfupload</type>
				<width title="Width" description="Resize box width" type="integer">1024</width>
				<height title="Height" description="Resize box height" type="integer">1024</height>
				<resizeDefault title="Resize Default" type="boolean" description="Resize images by default on upload (controllable during upload)">true</resizeDefault>
				<overwrite title="Overwrite" type="boolean" description="Overwrite existing files">false</overwrite>
			</uploader>
			<autoTitling title="Auto Titling" description="Automatically create titles from filenames. If FALSE, titles will be empty" type="boolean">true</autoTitling>
			<attributes title="Attributes">
				<image title="Image" type="array" separator="," description="Custom attributes available for images" options="custom,link,purchase,hotspot_coordinates,hotspot_url"></image>
				<folder title="Folder" type="array" separator="," description="Custom attributes for folders" options="url1"></folder>
			</attributes>
			<email title="Email">
				<allowEmail type="boolean" title="Enable Email" description="Enable/Disable email functions">false</allowEmail>
				<ownerEmail type="array" title="Owner Email" description="Your contact email addresses, comma-separated for more than one."></ownerEmail>
				<ownerBcc type="boolean" title="Email Me" description="Send yourself an email when someone shares a link from your gallery">true</ownerBcc>
				<contactSubj type="string" title="Contact Subject" description="Default subject for contact emails">Message from Imagevue contact form</contactSubj>
				<sendlinkSubj type="string" title="Send Link Subject" description="Default subject for sharing emails">You have received a link from [senderName]!</sendlinkSubj>
				<forceFrom type="string" title="Restrict Sender" description="If your host requires emails to be sent from a specific address, enter it here."></forceFrom>
			</email>
			<disableDashboard title="Disable Dashboard" description="Disable the admin dashboard" type="boolean">false</disableDashboard>
			<disableAdminbar title="Disable Adminbar" description="Disable the admin bar" type="boolean">false</disableAdminbar>
			<disableImageMeta title="Disable EXIF" description="Disable display of EXIF / IPTC metadata for images" type="boolean">false</disableImageMeta>
			<ffmpegPath title="FFMPEG Path" description="Path to FFmpeg for creating video thumbnails. If empty, it will probe for ffmpeg."></ffmpegPath>
		</settings>
		<controls>
			<maincontrols>
				<enabled type="boolean" description="Enable or disable main control module">true</enabled>
				<items type="array" description="Items to display in main controls" options="togglethumbnails,previous,scrollinfo,next,toggleplay,sfx,html,togglefullscreen,zoomin,zoomout,link,purchase,sendlink,contact,share,fotomoto,close">togglethumbnails,previous,scrollinfo,next,toggleplay,togglefullscreen</items>
				<autohide type="boolean" description="Show main controls only on hover">true</autohide>
				<align type="enum" description="Set main control alignment" options="ITL,ITM,ITR,IRT,IRM,IRB,IBR,IBM,IBL,ILB,ILM,ILT,OITL,OITM,OITR,OIRM,OIBR,OIBM,OIBL,OILM,OIM,TL,T,TR,R,BR,B,BL,L,M">B</align>
				<margin type="integer" description="Set main control margin relative to alignment" range="0,200">55</margin>
				<locktothumbnails type="boolean" description="Align controls relative to the thumbnail list">true</locktothumbnails>
			</maincontrols>
			<largecontrols>
				<enabled type="boolean" description="Enable large next/previous controls">true</enabled>
				<autohide type="boolean" description="Hide large controls when no mouse activity">true</autohide>
				<margin type="integer" description="Margin for large controls">50</margin>
			</largecontrols>
			<rightclick>
				<controls type="array" description="Controls available in the right-click context menu" options="next,previous,popup,lightbox,window,download,html,zoomin,zoomout,togglethumbnails,toggleplay,sendlink,link,purchase,fotomoto,copylocation,sfx,togglefullscreen,contact">next,previous,lightbox,download,html,zoomin,zoomout,togglethumbnails,toggleplay,sendlink,fotomoto,copylocation,sfx,togglefullscreen,contact</controls>
			</rightclick>
			<fullscreen_click type="boolean" description="Enter fullscreen mode on first gallery click">false</fullscreen_click>
			<keycontrols type="boolean" description="Enable arrow keys for navigation">true</keycontrols>
			<inverse_controls type="boolean" description="Invert next/previous directions">false</inverse_controls>
			<mousewheel type="enum" description="Mouse wheel action" options="zoom, togglethumbs, none">zoom</mousewheel>
			<altimage type="boolean" description="Open different versions of images via _altimage/ path">false</altimage>
		</controls>
		<audioplayer>
			<enabled type="boolean" description="Enable or disable audio player">true</enabled>
			<path type="dir" description="Initial path for audio folder">mp3/</path>
			<use_imagefolder type="boolean" description="Load tracks from the active image folder if MP3s exist">false</use_imagefolder>
			<autostart type="boolean" description="Start audio player when gallery starts">true</autostart>
			<startvolume type="integer" description="Initial volume level" range="1,100">75</startvolume>
			<repeat type="integer" description="Number of loops (0 for infinite)">0</repeat>
			<minimum_connection type="integer" description="Minimum connection speed required (KB/s)">20</minimum_connection>
			<sorting type="enum" description="Sorting order for tracks" options="na,nd,da,dd,sa,sd,rnd,auto">rnd</sorting>
			<id3tags type="array" description="ID3 tags to display">TIT2,TPE1</id3tags>
			<showplaylist type="boolean" description="Show or hide playlist">true</showplaylist>
			<showcontrols type="boolean" description="Show or hide player controls">true</showcontrols>
		</audioplayer>
		<image>
			<image>
				<margin type="integer" description="Minimum margin relative to stage boundary" range="0,500">94</margin>
				<scale type="enum" description="Image scaling method" options="fitmargin,original,fitstage,croptostage">fitmargin</scale>
				<scale_limit type="boolean" description="Prevent scaling larger than 100% of original size">false</scale_limit>
				<scale_reset type="boolean" description="Reset zoom on new image load">true</scale_reset>
				<image_panning type="boolean" description="Allow image panning with mouse if larger than stage">true</image_panning>
				<original_optimized type="boolean" description="Show original size even if it breaks bounds">false</original_optimized>
				<click type="enum" description="Mouse click event on current image" options="false,showthumbnails,next,popup,lightbox,window,download,togglefullscreen,toggleplay,link,html">next</click>
				<shiftclick type="enum" description="Shift+click event on current image" options="false,showthumbnails,next,previous,popup,lightbox,window,download,togglefullscreen,toggleplay,link,html">lightbox</shiftclick>
				<progress_bar type="enum" descriptions="Loading progress bar style" options="bar,spin,none">spin</progress_bar>
			</image>
			<slideshow>
				<autostart type="boolean" description="Start slideshow automatically">false</autostart>
				<interval type="integer" description="Interval between images in seconds" range="0,100">6</interval>
				<end_event type="event" description="Action on slideshow end" options="loop,stop,thumbnails,startpath,url">loop</end_event>
				<loop type="boolean" description="Seamless loop between last and first image">true</loop>
				<jsresize type="boolean" description="Resize popup images for slideshow fit">false</jsresize>
			</slideshow>
			<imagebuttons>
				<enabled type="boolean" description="Buttons appearing over current image">true</enabled>
				<align type="enum" description="Button alignment" options="ITL,ITM,ITR,IRT,IRM,IRB,IBR,IBM,IBL,ILB,ILM,ILT,OITL,OITM,OITR,OIRM,OIBR,OIBM,OIBL,OILM,OIM">OITR</align>
				<autohide type="boolean" description="Show buttons only on hover">true</autohide>
				<buttons type="array" description="Buttons to use on hover" options="imageinfo,window,popup,lightbox,copylocation,link,purchase,download,html,sendlink,contact,zoomin,zoomout,togglefullscreen,toggleplay,maplink,share,fotomoto">lightbox,download,zoomin,zoomout,maplink,share,fotomoto</buttons>
				<margin type="integer" description="Margin between buttons and image edge" range="0,100">20</margin>
			</imagebuttons>
			<closebutton>
				<enabled type="boolean" description="Close button for image view">true</enabled>
				<autohide type="boolean" description="Show close button only on hover">true</autohide>
			</closebutton>
			<text>
				<text1>
					<enabled type="boolean" description="Toggle description node on/off">true</enabled>
					<style type="enum" description="Display style for description" options="auto,right,bottom_right,left,below,above,over_image_top,over_image_bottom,over_image_left,over_image_right">above</style>
					<event type="enum" description="Trigger for description" options="static,rollover,imageinfo_button">static</event>
					<items type="array" description="Items to display in description" options="imageindex,titlepath,title,filename,dimensions,filesize,date,folderdescription,description,custom,exif,xmp,iptc,link,filelink,purchase,download,folderpath,foldername,abslink,fotomoto,fotomotoproducts,maplink,lightbox">title,description,maplink</items>
					<width type="string" description="Width of text item for supported styles. Supports pixels or %">200</width>
					<margin type="integer" description="Margin around text box" range="0,100">0</margin>
					<min_width type="integer" description="Minimum width">200</min_width>
					<scaleheight type="enum" description="Scale height" options="max,min">min</scaleheight>
					<height type="string" description="Maximum height for supported styles">200</height>
				</text1>
				<text2>
					<enabled type="boolean" description="Toggle description node on/off">true</enabled>
					<style type="enum" description="Display style for description" options="auto,right,bottom_right,left,below,above,over_image_top,over_image_bottom,over_image_left,over_image_right">over_image_right</style>
					<event type="enum" description="Trigger for description" options="static,rollover,imageinfo_button">rollover</event>
					<items type="array" description="Items to display in description" options="imageindex,titlepath,title,filename,dimensions,filesize,date,folderdescription,description,custom,exif,xmp,iptc,link,filelink,purchase,download,folderpath,foldername,abslink,fotomoto,fotomotoproducts,maplink,lightbox">exif,xmp</items>
					<width type="string" description="Width of text item. Supports pixels or %">250</width>
					<margin type="integer" description="Margin around text box" range="0,100">1</margin>
					<min_width type="integer" description="Minimum width">200</min_width>
					<scaleheight type="enum" description="Scale height" options="max,min">min</scaleheight>
					<height type="string" description="Maximum height for supported styles">500</height>
				</text2>
				<text3>
					<enabled type="boolean" description="Toggle description node on/off">false</enabled>
					<style type="enum" description="Display style for description" options="auto,right,bottom_right,left,below,above,over_image_top,over_image_bottom,over_image_left,over_image_right">above</style>
					<event type="enum" description="Trigger for description" options="static,rollover,imageinfo_button">static</event>
					<items type="array" description="Items to display in description" options="imageindex,titlepath,title,filename,dimensions,filesize,date,folderdescription,description,custom,exif,xmp,iptc,link,filelink,purchase,download,folderpath,foldername,abslink,fotomoto,fotomotoproducts,maplink,lightbox">fotomotoproducts</items>
					<width type="string" description="Width of text item. Supports pixels or %">200</width>
					<margin type="integer" description="Margin around text box" range="0,100">0</margin>
					<min_width type="integer" description="Minimum width">200</min_width>
					<scaleheight type="enum" description="Scale height" options="max,min">min</scaleheight>
					<height type="string" description="Maximum height for supported styles">500</height>
				</text3>
			</text>
			<imagelayer>
				<layer>
					<enabled type="boolean" description="Enable or disable this image layer">false</enabled>
					<filepath type="file" description="File path relative to library root">shape.swf</filepath>
					<opacity type="integer" description="Layer opacity" range="0,100">100</opacity>
					<align type="enum" description="Layer alignment" options="OITL,OITM,OITR,OIRM,OIBR,OIBM,OIBL,OILM,OIM">OITL</align>
					<margin type="integer" description="Margin from image edge" range="0,500">1</margin>
				</layer>
			</imagelayer>
		</image>
		<thumbnails>
			<thumbnail>
				<boxwidth type="integer" description="Thumbnail box width">160</boxwidth>
				<boxheight type="integer" description="Thumbnail box height">120</boxheight>
				<resizetype type="enum" options="resizetobox,croptobox" description="Method for creating thumbnails">croptobox</resizetype>
				<click type="enum" description="Click event on thumbnail" options="false,open,window,popup,lightbox,download,link,html">open</click>
				<shiftclick type="enum" description="Shift+click event on thumbnail" options="false,open,window,popup,lightbox,download,link,html">lightbox</shiftclick>
				<backgroundColor type="color" description="Background color for transparent .pngs">FFFFFF</backgroundColor>
			</thumbnail>
			<thumbnails>
				<margin type="array" description="Margins for thumbnail area: TOP,RIGHT,BOTTOM,LEFT">100,100,200,100</margin>
				<min_width type="integer" description="Minimum width for thumbnail area" range="0,2000">200</min_width>
				<min_height type="integer" description="Minimum height for thumbnail area" range="0,2000">200</min_height>
				<max_width type="integer" description="Maximum width for thumbnail area" range="0,2000">1200</max_width>
				<max_height type="integer" description="Maximum height for thumbnail area" range="0,2000">1000</max_height>
				<horizontalamount type="integer" description="Force horizontal columns (0 for auto)" range="0,100">0</horizontalamount>
				<verticalamount type="integer" description="Force vertical rows (0 for auto)" range="0,100">0</verticalamount>
				<text type="array" description="Text options to display above thumbnails" options="breadcrumbs,pagecount,title,description">breadcrumbs,title,pagecount,description</text>
				<sharebutton type="boolean" description="Enable social sharing button above thumbnails">true</sharebutton>
				<pagebuttons type="boolean" description="Enable pagination buttons">true</pagebuttons>
			</thumbnails>
			<thumbnailscroller>
				<enabled type="boolean" description="Enable thumbnail scroller">true</enabled>
				<autohide type="boolean" description="Hide scroller when inactive">false</autohide>
				<autohide_offset type="integer" description="Scroller offset in hide mode">10</autohide_offset>
				<tooltip type="boolean" description="Inherit tooltips for thumbnails">true</tooltip>
			</thumbnailscroller>
			<tooltip>
				<enabled type="boolean" description="Enable thumbnail tooltips">true</enabled>
				<items type="array" description="Items to display in tooltips" options="name,title,date,description">title,description</items>
				<interval type="integer" description="Delay before tooltip appears (ms)" range="0,2000">500</interval>
			</tooltip>
		</thumbnails>
		<textpage>
			<show_title type="boolean" description="Show title on text pages">true</show_title>
			<sharebutton type="boolean" description="Enable sharing on text pages">true</sharebutton>
		</textpage>
		<menu>
			<mainmenu>
				<enabled type="boolean" description="Enable gallery menu">true</enabled>
				<items type="array" description="Items to display in menu" options="node,title,amount">node,title,amount</items>
				<submenu_style type="enum" description="Submenu display style" options="vertical,horizontal">vertical</submenu_style>
				<close_same_level type="boolean" description="Expand only one node at a time">false</close_same_level>
				<autohide type="boolean" description="Hide menu when inactive">true</autohide>
				<startshow type="boolean" description="Don't hide menu on startup">false</startshow>
				<x_offset type="integer" description="Menu horizontal position from left">10</x_offset>
				<folderdescription>
					<enabled type="boolean" description="Enable tooltips and previews on menu hover">true</enabled>
					<items type="array" description="Items to show in menu tooltips" options="title,filecount,date,description,previewimage">title,filecount,description,previewimage</items>
				</folderdescription>
				<menu_logo type="string" description="Logo path to display above menu"></menu_logo>
				<menu_logo_link type="string" description="Link for the menu logo"></menu_logo_link>
			</mainmenu>
		</menu>
		<misc>
			<sharing>
				<enabled type="boolean" description="Enable sharing buttons">true</enabled>
				<sharebutton_click type="enum" description="Main sharing button click event" options="menu,extended">menu</sharebutton_click>
				<services type="string" description="Sharing services to display">email|E-mail,facebook,twitter,more</services>
				<addthis_username type="string" description="Addthis.com username for analytics"></addthis_username>
			</sharing>
			<sfx>
				<enabled type="boolean" description="Enable sound effects">true</enabled>
				<volume type="integer" description="Sound effects volume (1-100)" range="1,100">90</volume>
			</sfx>
			<video>
				<external_player type="boolean" description="Play video in external lightbox player">true</external_player>
				<controlsAutoHide type="boolean" description="Auto-hide video controls">true</controlsAutoHide>
				<autoPlay type="boolean" description="Auto-start videos">true</autoPlay>
				<loop type="boolean" description="Loop videos">false</loop>
				<bufferTime type="integer" description="Buffer time for video loading">5</bufferTime>
				<stopAudioPlayer type="boolean" description="Stop audio player when video loads">true</stopAudioPlayer>
			</video>
		</misc>
		<modules>
			<filemod>
				<align type="enum" description="Filemod alignment" options="TL,T,TR,R,BR,B,BL,L,M">M</align>
				<frame type="boolean" description="Display frame for filemod">true</frame>
				<text type="boolean" description="Display text above filemod">true</text>
				<textalign type="enum" description="Text alignment position" options="above,over">above</textalign>
			</filemod>
			<hotspot>
				<enabled type="boolean" description="Enable hotspot module">false</enabled>
				<event type="enum" description="Hotspot trigger event" options="static,rollover">rollover</event>
				<url_prefix type="string" description="URL prefix for hotspot links">http://www.imagevuex.com/</url_prefix>
				<window_target type="enum" description="Target for hotspot links" options="_blank,_parent,_top">_blank</window_target>
			</hotspot>
		</modules>
		<seo>
			<googleAnalytics title="Google Analytics Account ID" description="UA-XXXXX-Y"></googleAnalytics>
			<keywords type="string" description="SEO keywords, comma-separated">imagevue, flash, photo, image, gallery, slideshow</keywords>
			<description type="string" description="SEO gallery description">Another Gallery from Imagevuex.com</description>
			<counters title="Footer Code" type="text" description="Third-party stats or counter code for the footer"></counters>
			<htmlRedirect title="Redirect to Flash" type="boolean" description="Redirect users to Flash gallery if installed">true</htmlRedirect>
			<disableSitemap type="boolean" description="Disable sitemap generation">false</disableSitemap>
		</seo>
		<fotomoto>
			<enabled type="boolean" description="Enable Fotomoto cart">false</enabled>
			<siteKey type="string" description="Fotomoto Site Key / Store ID"></siteKey>
			<product_menu type="boolean" description="Show Fotomoto menu on hover">true</product_menu>
			<fotomotobutton_click type="enum" description="Fotomoto button click event" options="menu,window">menu</fotomotobutton_click>
			<default_page type="enum" description="Default Fotomoto landing page" options="buy,print,card,file,ecard">buy</default_page>
		</fotomoto>
		<mobile>
			<view type="enum" title="Folder View Mode" options="Thumbnails, Images, Images with Info, Images with Info Below" description="Default mobile view mode.">Thumbnails</view>
			<toolbar type="text" title="Toolbar Title" description="HTML for toolbar title (overrides folder title)."></toolbar>
			<heading title="Global Header" type="text" description="HTML for global mobile header.">&lt;a href=&quot;?/&quot;&gt;&lt;img src=&quot;iv-includes/images/mobile/mobile-global-header.jpg&quot;/&gt;&lt;/a&gt;</heading>
			<startpage title="Start Page Header" type="text" description="HTML for start page header.">&lt;a href=&quot;?/&quot;&gt;&lt;img src=&quot;iv-includes/images/mobile/mobile-start-header.jpg&quot;/&gt;&lt;/a&gt;</startpage>
			<footing title="Footer" type="text" description="Global footer HTML."></footing>
			<footer title="Footer Toolbar" type="text" description="Global footer toolbar HTML. Clear to remove.">&lt;a href=&quot;http://imagevuex.com&quot;&gt;&lt;img src=&quot;iv-includes/images/imagevueMobile.png&quot; height=&quot;20&quot;&gt;&lt;/a&gt;</footer>
			<mobileMenu title="Mobile Menu" type="boolean" description="Show folder tree on header click">true</mobileMenu>
			<showMenuThumbnails title="Show Menu Thumbnails" type="boolean" description="Show thumbnails in menu">true</showMenuThumbnails>
			<showMenuDescriptions title="Show Menu Descriptions" type="boolean" description="Show descriptions in menu">true</showMenuDescriptions>
			<showFileCounters title="Show File Counters" type="boolean" description="Show file counts in gallery list">false</showFileCounters>
			<columns title="Thumbnail Columns" type="int" description="Number of columns to display" range="1-4">3</columns>
			<jqueryMobileTheme title="Theme" type="enum" description="Select mobile theme" options="Dark, Light">Light</jqueryMobileTheme>
		</mobile>
	</imagevue>
</config>